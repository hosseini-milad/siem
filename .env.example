SIEM_MONGODB_URI=mongodb://127.0.0.1:27017
SIEM_MONGODB_DATABASE=siem
SIEM_DATASETS_ROOT=ds/Datasets
SIEM_MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
SIEM_MONGODB_CONNECT_TIMEOUT_MS=3000
SIEM_MONGODB_SOCKET_TIMEOUT_MS=60000
SIEM_ML_MODEL_DIR=data/ml
SIEM_ML_THREADS=2
SIEM_ELASTICSEARCH_URL=http://127.0.0.1:9200
SIEM_ELASTICSEARCH_INDEX=siem-events
SIEM_LOGSTASH_URL=http://127.0.0.1:9600
SIEM_LOGSTASH_INPUT_URL=http://127.0.0.1:8080
SIEM_KIBANA_URL=http://127.0.0.1:5601
SIEM_ELK_TIMEOUT_SECONDS=10
