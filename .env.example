SIEM_MONGODB_URI=mongodb://127.0.0.1:27017
SIEM_MONGODB_DATABASE=siem
SIEM_DATASETS_ROOT=ds/Datasets
SIEM_SYSTEM_LOG_DATASETS_ROOT=ds/OS
SIEM_MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
SIEM_MONGODB_CONNECT_TIMEOUT_MS=3000
SIEM_MONGODB_SOCKET_TIMEOUT_MS=60000
SIEM_ML_MODEL_DIR=data/ml
SIEM_ML_THREADS=2
SIEM_RAW_LOG_HOST=127.0.0.1
SIEM_RAW_LOG_PORT=0
# SIEM_HTTP_LOG_TOKEN=

# Optional JSONL web access log. Create a restricted directory first.
# SIEM_WEB_ACCESS_LOG_PATH=/path/to/private/siem-access.jsonl
# SIEM_WEB_COLLECTOR_KEYS={"siem-api":"<secret>"}
